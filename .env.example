# Copy to .env.local and adjust (Expo only reads these variables from a .local file).

# Your Mac's Tailscale IP (Tailscale menu-bar app, or `tailscale ip -4`).
# Makes the Expo QR code point at Tailscale, so the phone can load the app from any network.
REACT_NATIVE_PACKAGER_HOSTNAME=100.x.y.z

# Bundle id used for development builds and sideloaded .ipa/.apk files.
APP_BUNDLE_ID=com.example.claudemobile
